# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=api
# Replace with your actual Hostinger domain:
CORS_ORIGINS=https://dynime.com
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
SWAGGER_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
# Fill in your Hostinger MySQL credentials:
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://dynime_user:YOUR_DB_PASSWORD@localhost:3306/dynime_prod

# ── Auth ─────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate strong random secrets – never reuse these locally!
# Run: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_1
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_2
JWT_REFRESH_TTL=30d

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200

# ── Redis ─────────────────────────────────────────────────────────────────────
# If Hostinger provides Redis:
REDIS_URL=redis://localhost:6379
# If no Redis: BullMQ will fail gracefully, real-time sync won't work but core API will.

# ── Object Storage (MinIO / Cloudflare R2 / S3) ────────────────────────────
# Option A: Use Cloudflare R2 (free 10GB) — recommended for production:
# MINIO_ENDPOINT=YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
# MINIO_ACCESS_KEY=R2_ACCESS_KEY_ID
# MINIO_SECRET_KEY=R2_SECRET_ACCESS_KEY
# MINIO_REGION=auto
# MINIO_PUBLIC_URL=https://pub-XXXX.r2.dev

# Option B: No object storage (fallback to local disk — fine for Hostinger VPS):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=unused
MINIO_SECRET_KEY=unused
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000

