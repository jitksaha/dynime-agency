generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model abandoned_checkouts {
  id               String    @id @default(uuid()) @db.VarChar(36)
  email            String    @db.VarChar(255)
  name             String?   @db.VarChar(255)
  phone            String?   @db.VarChar(255)
  cart_data        Json?
  checkout_details Json?
  status           String    @default("abandoned") @db.VarChar(50)
  email_sent       Boolean   @default(false)
  last_active_at   DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)

  @@index([email], map: "abandoned_checkouts_email_index")
}

model admin_replies {
  id              String    @id @default(uuid()) @db.VarChar(36)
  target_type     String    @db.Text
  target_id       String    @db.VarChar(36)
  recipient_email String    @db.Text
  subject         String    @db.Text
  body            String    @db.Text
  sent_by         String?   @db.VarChar(36)
  sent_by_name    String?   @db.Text
  sent_by_email   String?   @db.Text
  status          String    @db.Text
  metadata        Json
  created_at      DateTime? @db.Timestamp(0)
}

model admin_users {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @db.VarChar(255)
  email          String           @unique(map: "admin_users_email_unique") @db.VarChar(255)
  password       String           @db.VarChar(255)
  role           admin_users_role @default(editor)
  is_active      Boolean          @default(true)
  remember_token String?          @db.VarChar(100)
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
}

model announcements {
  id           String    @id @default(uuid()) @db.VarChar(36)
  title        String    @db.Text
  body         String    @db.Text
  body_html    String?   @db.Text
  audience     String    @db.Text
  department   String?   @db.Text
  target_role  String?   @db.Text
  pinned       Boolean
  publish_at   DateTime? @db.Timestamp(0)
  expires_at   DateTime? @db.Timestamp(0)
  author_id    String?   @db.VarChar(36)
  is_published Boolean
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model app_auth_audit_log {
  id         String    @id @default(uuid()) @db.VarChar(36)
  user_id    String?   @db.VarChar(36)
  event_type String    @db.Text
  token_id   String?   @db.VarChar(36)
  ip_address String?   @db.Text
  user_agent String?   @db.Text
  metadata   Json?
  created_at DateTime? @db.Timestamp(0)
}

model app_refresh_tokens {
  id             String    @id @default(uuid()) @db.VarChar(36)
  user_id        String    @db.VarChar(36)
  token_hash     String    @unique(map: "app_refresh_tokens_token_hash_unique") @db.VarChar(255)
  family_id      String    @db.VarChar(36)
  device_id      String?   @db.Text
  device_label   String?   @db.Text
  user_agent     String?   @db.Text
  ip_address     String?   @db.Text
  issued_at      DateTime? @db.Timestamp(0)
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  revoked_at     DateTime? @db.Timestamp(0)
  revoked_reason String?   @db.Text
  replaced_by    String?   @db.VarChar(36)
  created_at     DateTime? @db.Timestamp(0)
  app_refresh_tokens       app_refresh_tokens?  @relation("app_refresh_tokensToapp_refresh_tokens", fields: [replaced_by], references: [id], map: "app_refresh_tokens_app_refresh_tokens_fk")
  other_app_refresh_tokens app_refresh_tokens[] @relation("app_refresh_tokensToapp_refresh_tokens")
}

model app_storage_audit_log {
  id         String    @id @default(uuid()) @db.VarChar(36)
  user_id    String?   @db.VarChar(36)
  event_type String    @db.Text
  bucket_id  String    @db.Text
  object_key String?   @db.Text
  size_bytes BigInt?
  mime_type  String?   @db.Text
  ip_address String?   @db.Text
  user_agent String?   @db.Text
  metadata   Json?
  created_at DateTime? @db.Timestamp(0)
}

model app_storage_migration_map {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  bucket_id          String    @db.Text
  object_key         String    @db.Text
  source_size        BigInt?
  source_etag        String?   @db.Text
  source_mime        String?   @db.Text
  source_modified_at DateTime? @db.Timestamp(0)
  dest_size          BigInt?
  dest_etag          String?   @db.Text
  status             String    @db.Text
  error              String?   @db.Text
  migrated_at        DateTime? @db.Timestamp(0)
  verified_at        DateTime? @db.Timestamp(0)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
}

model ats_jobs {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  flowmingo_job_id String    @unique(map: "ats_jobs_flowmingo_job_id_unique") @db.VarChar(255)
  slug             String    @unique(map: "ats_jobs_slug_unique") @db.VarChar(255)
  title            String    @db.VarChar(255)
  department       String    @db.VarChar(255)
  employment_type  String    @db.VarChar(255)
  location         String    @db.VarChar(255)
  salary_min       Decimal?  @db.Decimal(15, 2)
  salary_max       Decimal?  @db.Decimal(15, 2)
  salary_currency  String?   @db.VarChar(10)
  salary_period    String?   @db.VarChar(20)
  description      String?   @db.Text
  responsibilities Json?
  requirements     Json?
  benefits         Json?
  experience       String?   @db.VarChar(255)
  remote           Boolean   @default(false)
  featured         Boolean   @default(false)
  status           String    @default("open") @db.VarChar(255)
  apply_url        String    @db.VarChar(255)
  published_at     DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  deleted_at       DateTime? @db.Timestamp(0)

  @@index([department], map: "ats_jobs_department_index")
  @@index([featured], map: "ats_jobs_featured_index")
  @@index([remote], map: "ats_jobs_remote_index")
  @@index([status], map: "ats_jobs_status_index")
}

model attendance_records {
  id            String    @id @default(uuid()) @db.VarChar(36)
  employee_id   String    @db.VarChar(36)
  work_date     DateTime? @db.Date
  clock_in      DateTime? @db.Timestamp(0)
  clock_out     DateTime? @db.Timestamp(0)
  break_minutes Int       @default(0)
  total_minutes Int?
  source        String    @db.Text
  status        String    @default("present") @db.VarChar(50)
  notes         String?   @db.Text
  approved_by   String?   @db.VarChar(36)
  approved_at   DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  employees     employees @relation(fields: [employee_id], references: [id], map: "attendance_records_employees_fk")
}

model blog_posts {
  id              String    @id @default(uuid()) @db.VarChar(36)
  slug            String    @unique(map: "blog_posts_slug_unique") @db.VarChar(255)
  title           String    @db.Text
  excerpt         String?   @db.Text
  content         String?   @db.Text
  cover_image_url String?   @db.Text
  category        String    @db.Text
  tags            String    @db.Text
  author          String    @db.Text
  read_minutes    Int
  is_published    Boolean
  is_featured     Boolean
  sort_order      Int
  published_at    DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  view_count      Int
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model careers {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  title              String    @db.Text
  department         String    @db.Text
  location           String    @db.Text
  employment_type    String    @db.Text
  experience_level   String?   @db.Text
  salary_range       String?   @db.Text
  description        String?   @db.Text
  responsibilities   Json
  requirements       Json
  apply_url          String    @db.Text
  is_active          Boolean
  is_featured        Boolean
  sort_order         Int
  posted_at          DateTime? @db.Timestamp(0)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  slug               String    @unique(map: "careers_slug_unique") @db.VarChar(255)
  content_html       String?   @db.Text
  posting_channels   Json
  hero_image_url     String?   @db.Text
  vacancies          Int
  office_location_id String?   @db.VarChar(36)
  view_count         Int
  office_locations   office_locations?  @relation(fields: [office_location_id], references: [id], map: "careers_office_locations_fk")
  job_applications   job_applications[]
}

model chat_messages {
  id          String    @id @default(uuid()) @db.VarChar(36)
  session_id  String    @db.Text
  sender_type String    @db.Text
  sender_name String?   @db.Text
  message     String    @db.Text
  is_read     Boolean
  created_at  DateTime? @db.Timestamp(0)
}

model commissions {
  id                String    @id @default(uuid()) @db.VarChar(36)
  partner_id        String    @db.VarChar(36)
  order_id          String    @db.VarChar(36)
  customer_id       String?   @db.VarChar(36)
  service_name      String    @db.VarChar(255)
  order_amount      Decimal   @db.Decimal(10, 2)
  profit_amount     Decimal   @db.Decimal(10, 2)
  commission_amount Decimal   @db.Decimal(10, 2)
  status            String    @default("pending") @db.VarChar(50)
  approved_at       DateTime? @db.DateTime(0)
  paid_at           DateTime? @db.DateTime(0)
  payout_id         String?   @db.VarChar(36)
  created_at        DateTime? @default(now()) @db.DateTime(0)
  updated_at        DateTime? @default(now()) @db.DateTime(0)
  commission_type   String    @default("standard") @db.VarChar(50)
  cost_amount       Decimal?  @default(0.00) @db.Decimal(10, 2)
  partners          partners  @relation(fields: [partner_id], references: [id], map: "commissions_partners_fk")
  payouts           payouts?  @relation(fields: [payout_id], references: [id], map: "commissions_payouts_fk")
}

model contact_info {
  id         String    @id @default(uuid()) @db.VarChar(36)
  label      String    @db.Text
  type       String    @db.Text
  value      String    @db.Text
  icon       String?   @db.Text
  sort_order Int
  is_active  Boolean
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model contact_submissions {
  id          BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  type        contact_submissions_type   @default(contact)
  name        String                     @db.VarChar(255)
  email       String                     @db.VarChar(255)
  phone       String?                    @db.VarChar(50)
  subject     String?                    @db.VarChar(500)
  message     String                     @db.Text
  service     String?                    @db.VarChar(255)
  status      contact_submissions_status @default(new)
  admin_notes String?                    @db.Text
  ip_address  String?                    @db.VarChar(50)
  metadata    Json?
  created_at  DateTime?                  @db.Timestamp(0)
  updated_at  DateTime?                  @db.Timestamp(0)

  @@index([email], map: "contact_submissions_email_index")
  @@index([status], map: "contact_submissions_status_index")
}

model country_eligibility {
  id         String    @id @default(uuid()) @db.VarChar(36)
  name       String    @db.Text
  aliases    String    @db.Text
  status     String    @db.Text
  category   String    @db.Text
  reason     String    @db.Text
  is_active  Boolean
  sort_order Int
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model coupons {
  id                  String    @id @default(uuid()) @db.Char(36)
  code                String    @unique(map: "coupons_code_unique") @db.VarChar(255)
  description         String?   @db.Text
  discount_type       String    @db.VarChar(50)
  discount_value      Decimal   @db.Decimal(10, 2)
  min_order_amount    Decimal   @default(0.00) @db.Decimal(10, 2)
  max_discount_amount Decimal?  @db.Decimal(10, 2)
  usage_limit         Int?
  usage_count         Int       @default(0)
  starts_at           DateTime? @db.Timestamp(0)
  expires_at          DateTime? @db.Timestamp(0)
  is_active           Boolean   @default(true)
  is_milestone        Boolean   @default(false)
  milestone_mode      String?   @db.VarChar(50)
  advance_percent     Int?
  milestone_stages    String?   @db.LongText
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
}

model credit_applications {
  id               String    @id @default(uuid()) @db.VarChar(36)
  user_id          String    @db.VarChar(36)
  requested_limit  Decimal   @db.Decimal(20, 6)
  business_revenue Decimal?  @db.Decimal(20, 6)
  business_age     String?   @db.Text
  industry         String?   @db.Text
  country          String?   @db.Text
  notes            String?   @db.Text
  status           String    @db.Text
  admin_notes      String?   @db.Text
  reviewed_by      String?   @db.VarChar(36)
  reviewed_at      DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
}

model crm_activities {
  id               String    @id @default(uuid()) @db.VarChar(36)
  type             String    @db.Text
  subject          String    @db.Text
  description      String?   @db.Text
  due_at           DateTime? @db.Timestamp(0)
  completed_at     DateTime? @db.Timestamp(0)
  assignee_id      String?   @db.VarChar(36)
  lead_id          String?   @db.VarChar(36)
  deal_id          String?   @db.VarChar(36)
  customer_user_id String?   @db.VarChar(36)
  priority         String    @db.Text
  status           String    @db.Text
  metadata         Json
  created_by       String?   @db.VarChar(36)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  crm_deals        crm_deals? @relation(fields: [deal_id], references: [id], map: "crm_activities_crm_deals_fk")
  crm_leads        crm_leads? @relation(fields: [lead_id], references: [id], map: "crm_activities_crm_leads_fk")
}

model crm_campaign_recipients {
  id            String    @id @default(uuid()) @db.VarChar(36)
  campaign_id   String    @db.VarChar(36)
  email         String    @db.Text
  full_name     String?   @db.Text
  lead_id       String?   @db.VarChar(36)
  status        String    @db.Text
  error_message String?   @db.Text
  sent_at       DateTime? @db.Timestamp(0)
  created_at    DateTime? @db.Timestamp(0)
  crm_campaigns crm_campaigns @relation(fields: [campaign_id], references: [id], map: "crm_campaign_recipients_crm_campaigns_fk")
  crm_leads     crm_leads?    @relation(fields: [lead_id], references: [id], map: "crm_campaign_recipients_crm_leads_fk")
}

model crm_campaigns {
  id               String    @id @default(uuid()) @db.VarChar(36)
  name             String    @db.Text
  segment_id       String?   @db.VarChar(36)
  template_name    String    @db.Text
  subject          String    @db.Text
  body_html        String    @db.Text
  status           String    @db.Text
  scheduled_at     DateTime? @db.Timestamp(0)
  started_at       DateTime? @db.Timestamp(0)
  finished_at      DateTime? @db.Timestamp(0)
  total_recipients Int
  sent_count       Int
  failed_count     Int
  created_by       String?   @db.VarChar(36)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  crm_campaign_recipients crm_campaign_recipients[]
  crm_segments            crm_segments?             @relation(fields: [segment_id], references: [id], map: "crm_campaigns_crm_segments_fk")
}

model crm_deals {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  title               String    @db.Text
  lead_id             String?   @db.VarChar(36)
  customer_user_id    String?   @db.VarChar(36)
  customer_email      String?   @db.Text
  pipeline_id         String    @db.VarChar(36)
  stage_id            String    @db.VarChar(36)
  value               Decimal   @db.Decimal(20, 6)
  currency            String    @db.Text
  probability         Int
  expected_close_date DateTime? @db.Date
  closed_at           DateTime? @db.Timestamp(0)
  outcome             String?   @db.Text
  lost_reason         String?   @db.Text
  owner_id            String?   @db.VarChar(36)
  description         String?   @db.Text
  tags                String    @db.Text
  metadata            Json
  position            Int
  created_by          String?   @db.VarChar(36)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  crm_activities      crm_activities[]
  crm_leads           crm_leads?       @relation(fields: [lead_id], references: [id], map: "crm_deals_crm_leads_fk")
  crm_pipelines       crm_pipelines    @relation(fields: [pipeline_id], references: [id], map: "crm_deals_crm_pipelines_fk")
  crm_stages          crm_stages       @relation(fields: [stage_id], references: [id], map: "crm_deals_crm_stages_fk")
  crm_notes           crm_notes[]
}

model crm_email_templates {
  id         String    @id @default(uuid()) @db.VarChar(36)
  name       String    @db.Text
  subject    String    @db.Text
  body_html  String    @db.Text
  variables  Json
  is_active  Boolean
  created_by String?   @db.VarChar(36)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model crm_hubspot_sync {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  lead_id            String?   @db.VarChar(36)
  hubspot_contact_id String?   @db.Text
  direction          String    @db.Text
  status             String    @db.Text
  payload            Json?
  error              String?   @db.Text
  created_at         DateTime? @db.Timestamp(0)
  crm_leads          crm_leads? @relation(fields: [lead_id], references: [id], map: "crm_hubspot_sync_crm_leads_fk")
}

model crm_leads {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  full_name          String    @db.Text
  email              String?   @db.Text
  phone              String?   @db.Text
  company            String?   @db.Text
  job_title          String?   @db.Text
  country            String?   @db.Text
  source             String    @db.Text
  source_ref_id      String?   @db.VarChar(36)
  source_ref_table   String?   @db.Text
  status             String    @db.Text
  priority           String    @db.Text
  tags               String    @db.Text
  message            String?   @db.Text
  metadata           Json
  owner_id           String?   @db.VarChar(36)
  user_id            String?   @db.VarChar(36)
  converted_at       DateTime? @db.Timestamp(0)
  last_contacted_at  DateTime? @db.Timestamp(0)
  created_by         String?   @db.VarChar(36)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  score              Int
  score_breakdown    Json
  hubspot_contact_id String?   @db.Text
  crm_activities          crm_activities[]
  crm_campaign_recipients crm_campaign_recipients[]
  crm_deals               crm_deals[]
  crm_hubspot_sync        crm_hubspot_sync[]
  crm_notes               crm_notes[]
  crm_workflow_runs       crm_workflow_runs[]
}

model crm_notes {
  id               String    @id @default(uuid()) @db.VarChar(36)
  body             String    @db.Text
  lead_id          String?   @db.VarChar(36)
  deal_id          String?   @db.VarChar(36)
  customer_user_id String?   @db.VarChar(36)
  author_id        String?   @db.VarChar(36)
  created_at       DateTime? @db.Timestamp(0)
  crm_deals        crm_deals? @relation(fields: [deal_id], references: [id], map: "crm_notes_crm_deals_fk")
  crm_leads        crm_leads? @relation(fields: [lead_id], references: [id], map: "crm_notes_crm_leads_fk")
}

model crm_pipelines {
  id         String    @id @default(uuid()) @db.VarChar(36)
  name       String    @db.Text
  slug       String    @db.Text
  is_default Boolean
  is_active  Boolean
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  crm_deals  crm_deals[]
  crm_stages crm_stages[]
}

model crm_score_weights {
  id         Int       @id @db.SmallInt
  weights    Json
  updated_at DateTime? @db.Timestamp(0)
  updated_by String?   @db.VarChar(36)
}

model crm_segments {
  id              String    @id @default(uuid()) @db.VarChar(36)
  name            String    @db.Text
  description     String?   @db.Text
  audience        String    @db.Text
  filters         Json
  recipient_count Int
  created_by      String?   @db.VarChar(36)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  crm_campaigns   crm_campaigns[]
}

model crm_stages {
  id          String    @id @default(uuid()) @db.VarChar(36)
  pipeline_id String    @db.VarChar(36)
  name        String    @db.Text
  position    Int
  probability Int
  is_won      Boolean
  is_lost     Boolean
  color       String?   @db.Text
  created_at  DateTime? @db.Timestamp(0)
  crm_deals     crm_deals[]
  crm_pipelines crm_pipelines @relation(fields: [pipeline_id], references: [id], map: "crm_stages_crm_pipelines_fk")
}

model crm_workflow_runs {
  id           String    @id @default(uuid()) @db.VarChar(36)
  workflow_id  String    @db.VarChar(36)
  lead_id      String?   @db.VarChar(36)
  status       String    @db.Text
  current_step Int
  next_run_at  DateTime? @db.Timestamp(0)
  context      Json
  retries      Int
  last_error   String?   @db.Text
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  completed_at DateTime? @db.Timestamp(0)
  crm_leads     crm_leads?    @relation(fields: [lead_id], references: [id], map: "crm_workflow_runs_crm_leads_fk")
  crm_workflows crm_workflows @relation(fields: [workflow_id], references: [id], map: "crm_workflow_runs_crm_workflows_fk")
}

model crm_workflow_steps {
  id          String    @id @default(uuid()) @db.VarChar(36)
  workflow_id String    @db.VarChar(36)
  position    Int
  step_type   String    @db.Text
  config      Json
  created_at  DateTime? @db.Timestamp(0)
  crm_workflows crm_workflows @relation(fields: [workflow_id], references: [id], map: "crm_workflow_steps_crm_workflows_fk")
