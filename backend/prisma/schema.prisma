model verification_requests {
  id                  String                @id @default(uuid()) @db.Char(36)
  type                String                @db.VarChar(50)
  customer_id         String?               @db.Char(36)
  company_id          String?               @db.Char(36)
  service_order_id    String?               @db.VarChar(36)
  compliance_case_id  String?               @db.VarChar(255)
  didit_session_id    String?               @unique(map: "verification_requests_didit_session_id_unique") @db.VarChar(255)
  workflow_id         String?               @db.VarChar(255)
  verification_url    String?               @db.Text
  qr_code_url         String?               @db.Text
  status              String                @default("pending") @db.VarChar(50)
  decision            String?               @db.VarChar(50)
